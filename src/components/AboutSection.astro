---
---

<section id="about" class="py-16 md:py-24 bg-gradient-to-b from-[#0E0C0A] via-[#13100D] to-[#0E0C0A] border-t border-[#221C16] relative overflow-hidden">
  
  <!-- Glow Backdrop -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[450px] h-[450px] bg-[#E5A84B]/5 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      
      <!-- Left Column: Text Content -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Tagline -->
        <div class="inline-flex items-center gap-2 text-[#E5A84B]">
          <span class="text-xl">🌿</span>
          <span class="font-script-sub text-2xl text-[#F7C676]">About Us</span>
        </div>

        <!-- Main Title -->
        <h2 class="font-serif-heading text-4xl sm:text-5xl font-bold text-white leading-tight">
          We Serve Happiness <br />
          <span class="gold-gradient-text">On Your Plate</span>
        </h2>

        <!-- Description Paragraph -->
        <p class="text-base sm:text-lg text-[#C7BFB4] leading-relaxed">
          At SpiceRoots, we believe in serving more than just food. We serve experiences. Each dish is a rich blend of fresh daily-sourced ingredients, hand-ground aromatic spices, and a touch of heartfelt culinary tradition.
        </p>

        <p class="text-sm sm:text-base text-[#A39B8E] leading-relaxed">
          From slow-simmered curries to wood-fired tandoori specialties and artisanal desserts, our master chefs craft every recipe to bring families and friends together around unforgettable flavors.
        </p>

        <!-- Stats Counter Row -->
        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-[#26201A]">
          <div>
            <span class="block font-serif-heading text-3xl font-bold text-[#E5A84B]">15+</span>
            <span class="text-xs text-[#A39B8E]">Years Excellence</span>
          </div>
          <div>
            <span class="block font-serif-heading text-3xl font-bold text-[#E5A84B]">50+</span>
            <span class="text-xs text-[#A39B8E]">Master Dishes</span>
          </div>
          <div>
            <span class="block font-serif-heading text-3xl font-bold text-[#E5A84B]">100k+</span>
            <span class="text-xs text-[#A39B8E]">Happy Guests</span>
          </div>
        </div>

        <!-- Action Button -->
        <div class="pt-4">
          <a
            href="/about"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-gradient-to-r from-[#F7C676] via-[#E5A84B] to-[#C88D34] text-[#0E0C0A] font-bold text-base hover:brightness-110 shadow-[0_4px_20px_rgba(229,168,75,0.3)] active:scale-95 transition-all"
          >
            Learn More
          </a>
        </div>

      </div>

      <!-- Right Column: Restaurant Interior Image -->
      <div class="lg:col-span-6">
        <div class="relative rounded-3xl overflow-hidden border border-[#332920] shadow-[0_20px_50px_rgba(0,0,0,0.9)] group">
          <img 
            src="/images/restaurant-interior.png" 
            alt="SpiceRoots Dining Atmosphere" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 aspect-[4/3]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0E0C0A] via-transparent to-transparent opacity-60"></div>
          
          <!-- Floating Badge -->
          <div class="absolute bottom-6 right-6 bg-[#161310]/90 backdrop-blur-md border border-[#E5A84B]/40 px-5 py-3 rounded-2xl flex items-center gap-3">
            <span class="text-2xl">✨</span>
            <div>
              <span class="block text-sm font-bold text-white">Fine Dining Experience</span>
              <span class="block text-xs text-[#E5A84B]">Warm Ambient Lighting</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
