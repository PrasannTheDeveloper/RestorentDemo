---
---

<footer class="bg-[#0A0907] text-[#A39B8E] border-t border-[#221C16] pt-8 sm:pt-16 pb-6 sm:pb-8 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Compact Grid on Mobile (2 columns), Full on Desktop -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-12 gap-5 sm:gap-8 pb-6 sm:pb-12 border-b border-[#1F1A15]">
      
      <!-- Column 1: Logo & Social -->
      <div class="col-span-2 lg:col-span-4 space-y-3 sm:space-y-5">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#1C1814] border border-[#E5A84B]/40 flex items-center justify-center text-[#E5A84B] shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
              <path d="M17.5 3C15.57 3 13.5 4.3 12 5.9C10.5 4.3 8.43 3 6.5 3C3.42 3 1 5.42 1 8.5C1 14.5 12 21 12 21C12 21 23 14.5 23 8.5C23 5.42 20.58 3 17.5 3M12 18.55C9.28 16.03 3 10.97 3 8.5C3 6.57 4.57 5 6.5 5C8.07 5 9.87 6.13 11 7.6H13C14.13 6.13 15.93 5 17.5 5C19.43 5 21 6.57 21 8.5C21 10.97 14.72 16.03 12 18.55Z"/>
            </svg>
          </div>
          <div>
            <span class="font-serif-heading text-xl sm:text-2xl font-bold tracking-tight text-white">
              Spice<span class="text-[#E5A84B]">Roots</span>
            </span>
            <span class="block text-[8px] sm:text-[9px] uppercase tracking-[0.2em] text-[#A39B8E] -mt-1 font-medium">
              Flavors That Connect
            </span>
          </div>
        </a>

        <p class="text-[11px] sm:text-xs text-[#8A8175] leading-normal sm:leading-relaxed max-w-sm">
          Bringing authentic flavors, rich heritage spices, and memorable dining experiences right to your table.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-2.5 pt-1">
          <a href="#" aria-label="Facebook" class="w-8 h-8 rounded-full bg-[#161310] border border-[#2B231B] text-[#D1C9BF] flex items-center justify-center hover:bg-[#E5A84B] hover:text-[#0E0C0A] hover:border-[#E5A84B] transition-all">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="w-8 h-8 rounded-full bg-[#161310] border border-[#2B231B] text-[#D1C9BF] flex items-center justify-center hover:bg-[#E5A84B] hover:text-[#0E0C0A] hover:border-[#E5A84B] transition-all">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" aria-label="Twitter" class="w-8 h-8 rounded-full bg-[#161310] border border-[#2B231B] text-[#D1C9BF] flex items-center justify-center hover:bg-[#E5A84B] hover:text-[#0E0C0A] hover:border-[#E5A84B] transition-all">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="col-span-1 lg:col-span-2 space-y-2 sm:space-y-4">
        <h4 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Quick Links</h4>
        <ul class="space-y-1.5 sm:space-y-2.5 text-[11px] sm:text-xs font-medium">
          <li><a href="/" class="hover:text-[#E5A84B] transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-[#E5A84B] transition-colors">About Us</a></li>
          <li><a href="/menu" class="hover:text-[#E5A84B] transition-colors">Menu</a></li>
          <li><a href="/reservations" class="hover:text-[#E5A84B] transition-colors">Reservations</a></li>
          <li><a href="/contact" class="hover:text-[#E5A84B] transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Our Menu -->
      <div class="col-span-1 lg:col-span-2 space-y-2 sm:space-y-4">
        <h4 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Our Menu</h4>
        <ul class="space-y-1.5 sm:space-y-2.5 text-[11px] sm:text-xs font-medium">
          <li><a href="/menu" class="hover:text-[#E5A84B] transition-colors">Starters</a></li>
          <li><a href="/menu" class="hover:text-[#E5A84B] transition-colors">Main Course</a></li>
          <li><a href="/menu" class="hover:text-[#E5A84B] transition-colors">Biryani</a></li>
          <li><a href="/menu" class="hover:text-[#E5A84B] transition-colors">Desserts</a></li>
          <li><a href="/menu" class="hover:text-[#E5A84B] transition-colors">Beverages</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact Us -->
      <div class="col-span-2 sm:col-span-1 lg:col-span-2 space-y-2 sm:space-y-4">
        <h4 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Contact Us</h4>
        <ul class="space-y-1.5 sm:space-y-2.5 text-[11px] sm:text-xs">
          <li class="flex items-start gap-1.5">
            <span class="text-[#E5A84B]">📍</span>
            <span>123 Foodie Street, Flavor Town</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-[#E5A84B]">📞</span>
            <a href="tel:+1234567890" class="hover:text-[#E5A84B] transition-colors">+1 234 567 890</a>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="text-[#E5A84B]">✉️</span>
            <a href="mailto:info@spiceroots.com" class="hover:text-[#E5A84B] transition-colors truncate">info@spiceroots.com</a>
          </li>
        </ul>
      </div>

      <!-- Column 5: Newsletter -->
      <div class="col-span-2 sm:col-span-1 lg:col-span-2 space-y-2 sm:space-y-4">
        <h4 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Newsletter</h4>
        <p class="text-[11px] sm:text-xs text-[#8A8175]">
          Subscribe for updates and offers.
        </p>

        <form id="newsletterForm" class="space-y-1.5">
          <div class="relative">
            <input 
              type="email" 
              required
              placeholder="Enter your email" 
              class="w-full bg-[#161310] border border-[#2B231B] focus:border-[#E5A84B] rounded-lg px-3 py-2 text-[11px] text-white placeholder-[#685F54] focus:outline-none transition-colors pr-9"
            />
            <button 
              type="submit" 
              aria-label="Submit email"
              class="absolute right-1 top-1 bottom-1 px-2.5 rounded bg-[#E5A84B] text-[#0E0C0A] flex items-center justify-center hover:bg-[#F7C676] transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
              </svg>
            </button>
          </div>
          <p id="newsletterSuccess" class="text-[10px] text-[#E5A84B] hidden">Subscribed successfully!</p>
        </form>
      </div>

    </div>

    <!-- Bottom Copyright Banner -->
    <div class="pt-4 sm:pt-8 flex flex-col sm:flex-row items-center justify-between text-[10px] sm:text-xs text-[#736A5E] gap-2 sm:gap-4 text-center sm:text-left">
      <p>© 2025 SpiceRoots Restaurant. All Rights Reserved.</p>
      <div class="flex items-center gap-4 sm:gap-6">
        <a href="#" class="hover:text-[#E5A84B] transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-[#E5A84B] transition-colors">Terms & Conditions</a>
      </div>
    </div>

  </div>
</footer>

<script>
  document.getElementById('newsletterForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = document.getElementById('newsletterSuccess');
    if (msg) msg.classList.remove('hidden');
    (e.target as HTMLFormElement).reset();
  });
</script>
