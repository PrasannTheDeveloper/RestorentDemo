---
const testimonials = [
  {
    quote: "The best biryani I've ever had! The spices are perfectly balanced and the chicken melted in my mouth.",
    name: "Ravi Sharma",
    role: "Food Critic & Guest",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
  },
  {
    quote: "Amazing ambiance and great service. Paneer Butter Masala was rich, authentic, and truly divine!",
    name: "Priya Mehta",
    role: "Regular Visitor",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150&auto=format&fit=crop&q=80"
  },
  {
    quote: "A must-visit place for food lovers! The chocolate lava cake combined with hot chai was unforgettable.",
    name: "Arjun Verma",
    role: "Local Gourmet Enthusiast",
    rating: 5,
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80"
  }
];
---

<section class="py-16 md:py-24 bg-[#0E0C0A] relative border-t border-[#221C16]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title Divider -->
    <div class="text-center space-y-3 mb-12">
      <div class="flex items-center justify-center gap-4 text-[#E5A84B]">
        <span class="h-[1px] w-12 bg-gradient-to-r from-transparent to-[#E5A84B]"></span>
        <span class="font-script-sub text-2xl">Guest Reviews</span>
        <span class="h-[1px] w-12 bg-gradient-to-l from-transparent to-[#E5A84B]"></span>
      </div>
      <h2 class="font-serif-heading text-4xl sm:text-5xl font-bold text-white tracking-tight">
        What Our Customers Say
      </h2>
      <div class="w-16 h-[2px] bg-[#E5A84B] mx-auto rounded-full"></div>
    </div>

    <!-- Testimonials Grid / Carousel -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((item) => (
        <div class="bg-[#161310] border border-[#28211B] hover:border-[#E5A84B]/40 p-6 sm:p-8 rounded-2xl flex flex-col justify-between transition-all duration-300 hover:shadow-[0_10px_30px_rgba(0,0,0,0.8),0_0_20px_rgba(229,168,75,0.1)] group">
          
          <!-- Top Quote & Stars -->
          <div class="space-y-4">
            <div class="text-[#E5A84B] opacity-40 group-hover:opacity-100 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 fill-current" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>

            <p class="text-sm sm:text-base text-[#D1C9BF] italic leading-relaxed">
              "{item.quote}"
            </p>
          </div>

          <!-- Customer Avatar & Rating Row -->
          <div class="pt-6 mt-6 border-t border-[#221C16] flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img 
                src={item.avatar} 
                alt={item.name} 
                class="w-11 h-11 rounded-full object-cover border border-[#E5A84B]/50"
              />
              <div>
                <h4 class="text-sm font-bold text-white group-hover:text-[#E5A84B] transition-colors">{item.name}</h4>
                <p class="text-[11px] text-[#A39B8E]">{item.role}</p>
              </div>
            </div>

            <!-- Stars -->
            <div class="flex text-[#E5A84B] gap-0.5">
              {[...Array(item.rating)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Carousel Controls (Nav Arrows) -->
    <div class="flex items-center justify-center gap-4 mt-10">
      <button 
        aria-label="Previous Testimonial" 
        class="w-10 h-10 rounded-full border border-[#3D3224] text-[#E5A84B] flex items-center justify-center hover:bg-[#E5A84B] hover:text-[#0E0C0A] transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button 
        aria-label="Next Testimonial" 
        class="w-10 h-10 rounded-full border border-[#3D3224] text-[#E5A84B] flex items-center justify-center hover:bg-[#E5A84B] hover:text-[#0E0C0A] transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

  </div>
</section>
