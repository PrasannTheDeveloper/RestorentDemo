---
---

<!-- Reservation Modal Backdrop -->
<div 
  id="reservationModal" 
  class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
>
  <div 
    id="reservationModalBox" 
    class="bg-[#161310] border border-[#3D3224] rounded-3xl w-full max-w-lg p-6 sm:p-8 shadow-[0_25px_60px_rgba(0,0,0,0.9)] transform scale-95 transition-transform duration-300 relative text-left"
  >
    <!-- Close Button -->
    <button 
      id="closeReservationBtn" 
      aria-label="Close modal"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-[#221C17] text-[#A39B8E] hover:text-white hover:bg-[#E5A84B] hover:text-[#0E0C0A] flex items-center justify-center transition-all cursor-pointer focus:outline-none"
    >
      ✕
    </button>

    <!-- Header -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center gap-2 text-[#E5A84B] mb-1">
        <span class="text-xl">🍷</span>
        <span class="font-script-sub text-xl text-[#F7C676]">Book a Table</span>
      </div>
      <h3 class="font-serif-heading text-2xl font-bold text-white">Reserve Your Experience</h3>
      <p class="text-xs text-[#A39B8E] mt-1">We look forward to welcoming you at SpiceRoots</p>
    </div>

    <!-- Form -->
    <form id="reservationForm" class="space-y-4">
      <!-- Full Name & Phone -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[#D1C9BF] mb-1">Full Name</label>
          <input 
            type="text" 
            required 
            placeholder="John Doe" 
            class="w-full bg-[#0E0C0A] border border-[#2B231B] focus:border-[#E5A84B] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-[#5C5348] focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#D1C9BF] mb-1">Phone Number</label>
          <input 
            type="tel" 
            required 
            placeholder="+1 (555) 000-0000" 
            class="w-full bg-[#0E0C0A] border border-[#2B231B] focus:border-[#E5A84B] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-[#5C5348] focus:outline-none transition-colors"
          />
        </div>
      </div>

      <!-- Guests & Date -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[#D1C9BF] mb-1">Guests</label>
          <select class="w-full bg-[#0E0C0A] border border-[#2B231B] focus:border-[#E5A84B] rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none transition-colors">
            <option value="2">2 Guests</option>
            <option value="4">4 Guests</option>
            <option value="6">6 Guests</option>
            <option value="8">8+ Large Party</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#D1C9BF] mb-1">Date</label>
          <input 
            type="date" 
            required 
            class="w-full bg-[#0E0C0A] border border-[#2B231B] focus:border-[#E5A84B] rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none transition-colors"
          />
        </div>
      </div>

      <!-- Time Slot -->
      <div>
        <label class="block text-xs font-semibold text-[#D1C9BF] mb-1">Time Slot</label>
        <select class="w-full bg-[#0E0C0A] border border-[#2B231B] focus:border-[#E5A84B] rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none transition-colors">
          <option value="17:00">05:00 PM - Dinner</option>
          <option value="18:30">06:30 PM - Dinner</option>
          <option value="20:00">08:00 PM - Prime Dining</option>
          <option value="21:30">09:30 PM - Late Dining</option>
        </select>
      </div>

      <!-- Special Requests -->
      <div>
        <label class="block text-xs font-semibold text-[#D1C9BF] mb-1">Special Requests (Optional)</label>
        <textarea 
          rows="2" 
          placeholder="Dietary requirements, anniversary seating..." 
          class="w-full bg-[#0E0C0A] border border-[#2B231B] focus:border-[#E5A84B] rounded-xl px-3.5 py-2 text-xs text-white placeholder-[#5C5348] focus:outline-none transition-colors resize-none"
        ></textarea>
      </div>

      <!-- Submit CTA -->
      <button 
        type="submit" 
        class="w-full py-3.5 rounded-full bg-gradient-to-r from-[#F7C676] via-[#E5A84B] to-[#C88D34] text-[#0E0C0A] font-bold text-sm hover:brightness-110 shadow-[0_4px_20px_rgba(229,168,75,0.3)] active:scale-95 transition-all cursor-pointer mt-2"
      >
        Confirm Table Reservation
      </button>
    </form>

    <!-- Confirmation Toast Box -->
    <div id="reservationSuccess" class="hidden text-center py-8 space-y-4">
      <div class="w-16 h-16 rounded-full bg-[#E5A84B]/20 text-[#E5A84B] border border-[#E5A84B] flex items-center justify-center text-3xl mx-auto">
        ✓
      </div>
      <h4 class="font-serif-heading text-2xl font-bold text-white">Reservation Confirmed!</h4>
      <p class="text-xs text-[#C7BFB4] max-w-xs mx-auto">
        We have reserved your table. A confirmation message has been sent to your details.
      </p>
      <button 
        id="doneReservationBtn" 
        class="px-6 py-2.5 rounded-full bg-[#E5A84B] text-[#0E0C0A] font-bold text-xs hover:bg-[#F7C676] transition-colors cursor-pointer"
      >
        Great, Thank You!
      </button>
    </div>

  </div>
</div>

<script>
  const modal = document.getElementById('reservationModal');
  const modalBox = document.getElementById('reservationModalBox');
  const closeBtn = document.getElementById('closeReservationBtn');
  const form = document.getElementById('reservationForm');
  const successBox = document.getElementById('reservationSuccess');
  const doneBtn = document.getElementById('doneReservationBtn');

  function openModal() {
    modal?.classList.remove('opacity-0', 'pointer-events-none');
    modalBox?.classList.remove('scale-95');
    modalBox?.classList.add('scale-100');
  }

  function closeModal() {
    modal?.classList.add('opacity-0', 'pointer-events-none');
    modalBox?.classList.remove('scale-100');
    modalBox?.classList.add('scale-95');
    setTimeout(() => {
      form?.classList.remove('hidden');
      successBox?.classList.add('hidden');
    }, 300);
  }

  window.addEventListener('open-reservation', openModal);
  closeBtn?.addEventListener('click', closeModal);
  doneBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.classList.add('hidden');
    successBox?.classList.remove('hidden');
  });
</script>
