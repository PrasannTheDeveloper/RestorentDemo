---

---

<section
  class="relative pt-6 pb-12 md:py-20 lg:py-24 overflow-hidden bg-gradient-to-b from-[#0E0C0A] via-[#14110E] to-[#0E0C0A]"
>
  <!-- Subtle Glowing Ambient Backdrop -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[500px] h-[320px] sm:h-[500px] bg-[#E5A84B]/15 rounded-full blur-[120px] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
      <!-- Left / Top Column: Content -->
      <div
        class="lg:col-span-7 space-y-6 sm:space-y-8 text-center lg:text-left"
      >
        <!-- Welcome Tagline -->
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#1C1814] border border-[#3D3224] text-[#E5A84B] shadow-[0_0_15px_rgba(229,168,75,0.15)]"
        >
          <span class="text-[#E5A84B] text-xs">🌿</span>
          <span class="font-script-sub text-lg sm:text-xl text-[#F7C676]"
            >Welcome to SpiceRoots</span
          >
          <span class="text-[#E5A84B] text-xs">🌿</span>
        </div>

        <!-- Main Headline (Luxury Shimmer & Gold Glow) -->
        <div class="relative py-2">
          <!-- Subtle Glow Aura behind headline -->
          <!-- Ornamental Gold Divider Line -->
          <div
            class="flex items-center justify-center lg:justify-start gap-3 mt-3 opacity-90"
          >
            <div
              class="h-[1px] w-12 sm:w-20 bg-gradient-to-r from-transparent via-[#E5A84B] to-transparent"
            >
            </div>
            <span class="text-[#E5A84B] text-xs sm:text-sm">✦</span>
            <div
              class="h-[1px] w-12 sm:w-20 bg-gradient-to-r from-transparent via-[#E5A84B] to-transparent"
            >
            </div>
          </div>
          <div
            class="absolute -top-4 left-1/2 lg:left-0 -translate-x-1/2 lg:translate-x-0 w-48 sm:w-72 h-20 bg-[#E5A84B]/20 blur-[50px] rounded-full pointer-events-none"
          >
          </div>

          <h1
            class="font-serif-heading text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.05] relative z-10"
          >
            <div class="flex items-center justify-center gap-3 sm:gap-6">
              <span class="flex items-center">
                <span class="w-8 sm:w-14 lg:w-20 h-px bg-[#d4af37]"></span>
                <span class="text-[#d4af37] text-sm sm:text-base ml-1">✦</span>
              </span>

              <span>
                <span class="text-white gold-text-glow">Good</span>
                <span class="gold-shimmer-text font-black">Food</span>
              </span>
            </div>

            <div class="flex items-center justify-center gap-3 sm:gap-6 mt-1">
              <span>
                <span class="text-white gold-text-glow">Good</span>
                <span class="gold-shimmer-text font-black">Mood</span>
              </span>

              <span class="flex items-center">
                <span class="text-[#d4af37] text-sm sm:text-base mr-1">✦</span>
                <span class="w-8 sm:w-14 lg:w-20 h-px bg-[#d4af37]"></span>
              </span>
            </div>
          </h1>

          <!-- Ornamental Gold Divider Line -->
          <div
            class="flex items-center justify-center lg:justify-start gap-3 mt-3 opacity-90"
          >
            <div
              class="h-[1px] w-12 sm:w-20 bg-gradient-to-r from-transparent via-[#E5A84B] to-transparent"
            >
            </div>
            <span class="text-[#E5A84B] text-xs sm:text-sm">✦</span>
            <div
              class="h-[1px] w-12 sm:w-20 bg-gradient-to-r from-transparent via-[#E5A84B] to-transparent"
            >
            </div>
          </div>
        </div>

        <!-- Paragraph -->
        <p
          class="text-sm sm:text-lg text-[#C7BFB4] max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal"
        >
          Experience the perfect blend of tradition and taste. Delicious meals
          made with love, just for you!
        </p>

        <!-- CTA Action Buttons (Mobile friendly full width / desktop inline) -->
        <div
          class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-1 sm:pt-2"
        >
          <a
            href="#specialties"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl sm:rounded-full bg-gradient-to-r from-[#F7C676] via-[#E5A84B] to-[#C88D34] text-[#0E0C0A] font-bold text-sm sm:text-base hover:brightness-110 shadow-[0_4px_20px_rgba(229,168,75,0.35)] active:scale-95 transition-all text-center"
          >
            Explore Our Menu
          </a>
          <button
            id="heroBookTableBtn"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl sm:rounded-full bg-[#161310] border border-[#E5A84B]/50 text-white hover:border-[#E5A84B] hover:bg-[#1F1914] font-semibold text-sm sm:text-base active:scale-95 transition-all cursor-pointer shadow-md"
          >
            Book a Table
          </button>
        </div>

        <!-- Feature Badges Row (STRICTLY HORIZONTAL ON MOBILE & DESKTOP) -->
        <div
          class="pt-6 border-t border-[#26201A] grid grid-cols-3 gap-2 sm:gap-6 max-w-2xl mx-auto lg:mx-0"
        >
          <!-- Badge 1 -->
          <div
            class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-1.5 sm:gap-3 p-2.5 sm:p-0 rounded-2xl bg-[#161310]/80 sm:bg-transparent border border-[#2B231B] sm:border-0 group"
          >
            <div
              class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#1C1814] border border-[#3D3224] flex items-center justify-center text-[#E5A84B] group-hover:border-[#E5A84B] transition-colors shrink-0 text-sm sm:text-base"
            >
              🌿
            </div>
            <div>
              <h4
                class="text-[11px] sm:text-sm font-bold text-white leading-tight"
              >
                Fresh Ingredients
              </h4>
              <p class="text-[9px] sm:text-xs text-[#A39B8E] mt-0.5">
                Sourced Daily
              </p>
            </div>
          </div>

          <!-- Badge 2 -->
          <div
            class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-1.5 sm:gap-3 p-2.5 sm:p-0 rounded-2xl bg-[#161310]/80 sm:bg-transparent border border-[#2B231B] sm:border-0 group"
          >
            <div
              class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#1C1814] border border-[#3D3224] flex items-center justify-center text-[#E5A84B] group-hover:border-[#E5A84B] transition-colors shrink-0 text-sm sm:text-base"
            >
              👨‍🍳
            </div>
            <div>
              <h4
                class="text-[11px] sm:text-sm font-bold text-white leading-tight"
              >
                Expert Chefs
              </h4>
              <p class="text-[9px] sm:text-xs text-[#A39B8E] mt-0.5">
                Passionate Team
              </p>
            </div>
          </div>

          <!-- Badge 3 -->
          <div
            class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-1.5 sm:gap-3 p-2.5 sm:p-0 rounded-2xl bg-[#161310]/80 sm:bg-transparent border border-[#2B231B] sm:border-0 group"
          >
            <div
              class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#1C1814] border border-[#3D3224] flex items-center justify-center text-[#E5A84B] group-hover:border-[#E5A84B] transition-colors shrink-0 text-sm sm:text-base"
            >
              🛡️
            </div>
            <div>
              <h4
                class="text-[11px] sm:text-sm font-bold text-white leading-tight"
              >
                Hygienic Kitchen
              </h4>
              <p class="text-[9px] sm:text-xs text-[#A39B8E] mt-0.5">
                100% Safe
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Hero Dish Image (Luxury Circular Frame) -->
      <div class="lg:col-span-5 relative flex justify-center pt-4 lg:pt-0">
        <div
          class="relative w-full max-w-[320px] sm:max-w-[460px] aspect-square rounded-full bg-gradient-to-tr from-[#E5A84B]/25 via-[#1C1814] to-[#0E0C0A] p-2 sm:p-4 border border-[#3D3224] shadow-[0_20px_50px_rgba(0,0,0,0.9)] group"
        >
          <img
            src="/images/hero-curry-dish.png"
            alt="SpiceRoots Gourmet Feast"
            class="w-full h-full object-cover rounded-full shadow-2xl group-hover:scale-105 transition-transform duration-700"
          />
          <!-- Decorative Floating Steam Badge -->
          <div
            class="absolute -bottom-1 left-1/2 -translate-x-1/2 sm:translate-x-0 sm:bottom-4 sm:left-2 bg-[#161310]/95 backdrop-blur-md border border-[#E5A84B]/50 px-4 py-2 sm:px-5 sm:py-2.5 rounded-2xl flex items-center gap-3 shadow-2xl whitespace-nowrap"
          >
            <span class="text-xl sm:text-2xl">🔥</span>
            <div class="text-left">
              <span class="block text-xs font-bold text-white"
                >Chef's Special</span
              >
              <span class="block text-[10px] text-[#E5A84B] font-medium"
                >Authentic Spices</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById("heroBookTableBtn")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-reservation"));
  });
</script>
