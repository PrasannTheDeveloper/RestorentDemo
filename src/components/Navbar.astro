---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "About Us", href: "/about" },
  { name: "Menu", href: "/menu" },
  { name: "Reservations", href: "/reservations" },
  { name: "Gallery", href: "/gallery" },
  { name: "Blog", href: "/blog" },
  { name: "Contact", href: "/contact" }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-[#0E0C0A]/90 backdrop-blur-md border-b border-[#2C241B]/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-10 h-10 rounded-full bg-[#1C1814] border border-[#E5A84B]/40 flex items-center justify-center text-[#E5A84B] group-hover:border-[#E5A84B] group-hover:scale-105 transition-all shadow-[0_0_15px_rgba(229,168,75,0.2)]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M17.5 3C15.57 3 13.5 4.3 12 5.9C10.5 4.3 8.43 3 6.5 3C3.42 3 1 5.42 1 8.5C1 14.5 12 21 12 21C12 21 23 14.5 23 8.5C23 5.42 20.58 3 17.5 3M12 18.55C9.28 16.03 3 10.97 3 8.5C3 6.57 4.57 5 6.5 5C8.07 5 9.87 6.13 11 7.6H13C14.13 6.13 15.93 5 17.5 5C19.43 5 21 6.57 21 8.5C21 10.97 14.72 16.03 12 18.55Z"/>
        </svg>
      </div>
      <div>
        <span class="font-serif-heading text-2xl font-bold tracking-tight text-white group-hover:text-[#E5A84B] transition-colors">
          Spice<span class="text-[#E5A84B]">Roots</span>
        </span>
        <span class="block text-[9px] uppercase tracking-[0.25em] text-[#A39B8E] -mt-1 font-medium">
          Flavors That Connect
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-sm font-medium transition-all duration-200 hover:text-[#E5A84B] relative py-1 ${
              isActive 
                ? "text-[#E5A84B] font-semibold after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-[#E5A84B] after:rounded-full" 
                : "text-[#D1C9BF]"
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      
      <!-- Search Button -->
      <button 
        id="openSearchBtn" 
        aria-label="Search" 
        class="w-10 h-10 rounded-full flex items-center justify-center text-[#D1C9BF] hover:text-[#E5A84B] hover:bg-[#1A1613] transition-colors focus:outline-none"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Cart Button -->
      <button 
        id="openCartBtn" 
        aria-label="Shopping Cart" 
        class="w-10 h-10 rounded-full flex items-center justify-center text-[#D1C9BF] hover:text-[#E5A84B] hover:bg-[#1A1613] transition-colors relative focus:outline-none"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span id="cartCountBadge" class="absolute -top-1 -right-1 w-5 h-5 bg-[#E5A84B] text-[#0E0C0A] font-bold text-[11px] rounded-full flex items-center justify-center shadow-md scale-100 transition-transform">
          0
        </span>
      </button>

      <!-- Book A Table CTA Button (Desktop) -->
      <button
        id="openReservationBtn"
        class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-gradient-to-r from-[#F7C676] via-[#E5A84B] to-[#C88D34] text-[#0E0C0A] font-semibold text-sm hover:brightness-110 active:scale-95 transition-all shadow-[0_4px_15px_rgba(229,168,75,0.3)] cursor-pointer"
      >
        Book a Table
      </button>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobileMenuBtn" 
        aria-label="Toggle Menu" 
        class="lg:hidden w-10 h-10 rounded-full flex items-center justify-center text-[#E5A84B] bg-[#161310] border border-[#2C241B] hover:bg-[#1F1914] focus:outline-none"
      >
        <svg id="hamburgerIcon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="closeIcon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobileDrawer" class="hidden lg:hidden bg-[#13100D] border-b border-[#2C241B] px-6 py-6 transition-all duration-300">
    <div class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-base font-medium text-[#EAE5DC] hover:text-[#E5A84B] py-2 border-b border-[#221C17] flex items-center justify-between"
        >
          <span>{link.name}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#A39B8E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}

      <button
        id="mobileReservationBtn"
        class="w-full mt-4 py-3 rounded-full bg-gradient-to-r from-[#F7C676] via-[#E5A84B] to-[#C88D34] text-[#0E0C0A] font-bold text-base hover:brightness-110 shadow-lg text-center cursor-pointer"
      >
        Book a Table Now
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Mobile reservation button click
  document.getElementById('mobileReservationBtn')?.addEventListener('click', () => {
    mobileDrawer?.classList.add('hidden');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('open-reservation'));
  });

  // Desktop reservation button click
  document.getElementById('openReservationBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-reservation'));
  });

  // Cart button click
  document.getElementById('openCartBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cart'));
  });

  // Search button click
  document.getElementById('openSearchBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>
