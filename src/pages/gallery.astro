---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ReservationModal from "../components/ReservationModal.astro";
import CartDrawer from "../components/CartDrawer.astro";
import SearchModal from "../components/SearchModal.astro";

const galleryImages = [
  { src: "/images/hero-curry-dish.png", title: "Signature Gourmet Curry" },
  { src: "/images/paneer-butter-masala.png", title: "Paneer Butter Masala" },
  { src: "/images/hyderabadi-biryani.png", title: "Dum Biryani Special" },
  { src: "/images/grilled-chicken.png", title: "Flame Grilled Chicken Skewers" },
  { src: "/images/chocolate-lava-cake.png", title: "Molten Chocolate Lava Cake" },
  { src: "/images/restaurant-interior.png", title: "Ambient Dining Room" },
  { src: "/images/starter-samosa.png", title: "Golden Crispy Samosas" }
];
---

<Layout>
  <Navbar />
  <main class="py-16 md:py-24 bg-[#0E0C0A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="font-script-sub text-3xl text-[#E5A84B]">Visual Experience</span>
      <h1 class="font-serif-heading text-5xl font-bold text-white mt-2 mb-4">Our Gallery</h1>
      <div class="w-20 h-1 bg-[#E5A84B] mx-auto mb-12 rounded-full"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map((img) => (
          <div class="relative group overflow-hidden rounded-2xl border border-[#2B231B] aspect-[4/3] bg-[#161310]">
            <img src={img.src} alt={img.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0E0C0A] via-transparent to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            <div class="absolute bottom-4 left-4 right-4 text-left">
              <span class="text-xs font-bold text-[#E5A84B] uppercase tracking-wider">SpiceRoots</span>
              <h3 class="font-serif-heading text-lg font-bold text-white mt-0.5">{img.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  <ReservationModal />
  <CartDrawer />
  <SearchModal />
</Layout>
